
# Configuration and secrets
.env
.streamlit/secrets.toml

# Python caching and environment
__pycache__/
*.pyc
venv/
.venv/

# Node package-manager cache
.pnpm-store/

# OS-specific files
.DS_Store

# Exclude markdown files
*.md

# Downloaded third party datasets (not redistributed)
data/external/

# Red team: keep docs, ignore raw runs and local quota state
!redteam/**/*.md
!redteam/*.md
redteam/runs/
.redteam_quota.json
